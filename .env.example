# ==========================================================
# CONFIGURACIÓN DE CUENTAS DE INSTAGRAM Y TIKTOK
# ==========================================================

# 1. INSTAGRAM GRAPH API
# ID de tu cuenta de Instagram Business o Creador
IG_USER_ID=TU_INSTAGRAM_USER_ID

# Token de Acceso de Meta (con permisos instagram_basic e instagram_content_publish)
IG_ACCESS_TOKEN=TU_META_PAGE_ACCESS_TOKEN

# 2. TIKTOK CONTENT POSTING API
# Token de acceso Bearer de tu app de TikTok Developer (permiso video.upload)
TIKTOK_ACCESS_TOKEN=TU_TIKTOK_ACCESS_TOKEN

# 3. URL PÚBLICA DE TU SERVIDOR LOCAL (Requerido por Meta/TikTok para descargar las imágenes/vídeos)
# Puedes usar ngrok ejecutando: `npx ngrok http 3000`
PUBLIC_BASE_URL=https://tu-subdominio-ngrok.ngrok-free.app
